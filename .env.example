# Copy to .env for local development. Values below match a local `pnpm db:start` stack.
# The two keys are the public, well-known local Supabase demo keys; never commit real keys.

# ---- Client (exposed to the browser; only public values here) ----
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Leave empty to use the dev proxy (same origin). Set for the mobile app, e.g. https://api.example.com
VITE_API_URL=
# Cloudflare Turnstile site key. Leave empty locally to skip the captcha.
VITE_TURNSTILE_SITE_KEY=

# ---- Server (secret; never exposed to the client) ----
PORT=2567
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Local demo service key. In production, set this from your secret manager.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# Leave empty to use in-memory rate limits (one server instance only).
REDIS_URL=
# none | turnstile | hcaptcha
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET=
TRUST_PROXY=0

# Supabase CLI: the local stack enables a placeholder Twilio provider so test phone numbers work.
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=local-dev-placeholder
