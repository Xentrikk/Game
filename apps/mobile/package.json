{
  "name": "@hearth/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "pnpm --filter @hearth/client build",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "sync": "pnpm build:web && cap sync",
    "android": "pnpm sync && cap open android",
    "ios": "pnpm sync && cap open ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "typescript": "^5.7.2"
  }
}
